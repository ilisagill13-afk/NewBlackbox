<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Enter amount (USD):" android:textSize="14sp"
        android:textColor="#212121" android:layout_marginBottom="12dp" />

    <EditText android:id="@+id/et_amount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="e.g. 1000"
        android:inputType="numberDecimal" android:textSize="18sp"
        android:padding="12dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:id="@+id/tv_buy_info" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"
        android:textColor="#212121" android:layout_marginBottom="12dp"
        android:text="Current price: $0.00" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Amount to invest (USD):" android:textSize="13sp"
        android:textColor="#757575" android:layout_marginBottom="8dp" />

    <EditText android:id="@+id/et_invest_amount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="e.g. 500"
        android:inputType="numberDecimal" android:textSize="16sp"
        android:padding="10dp" />

    <TextView android:id="@+id/tv_cash_available" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="#9E9E9E" android:layout_marginTop="6dp"
        android:text="Available: $0.00" />

</LinearLayout>

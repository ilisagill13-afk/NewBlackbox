<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_surface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_dark"
        android:elevation="4dp"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/accent_gold" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <!-- HERO: Price Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardCornerRadius="16dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/bg_dark">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp" android:gravity="center">
                    <TextView android:id="@+id/tv_symbol_large" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold"
                        android:textColor="@color/white" android:text="AAPL" />
                    <TextView android:id="@+id/tv_company_name" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:textColor="@color/text_secondary" android:layout_marginTop="2dp" android:text="Apple Inc." />
                    <TextView android:id="@+id/tv_price_large" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="40sp" android:textStyle="bold"
                        android:textColor="@color/white" android:layout_marginTop="10dp" android:text="$150.00" />
                    <TextView android:id="@+id/tv_change_large" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
                        android:layout_marginTop="4dp" android:text="▲ +2.50%" />
                    <TextView android:id="@+id/tv_recommendation" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="20sp" android:textStyle="bold"
                        android:layout_marginTop="10dp" android:text="🔥 STRONG BUY" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- SIGNAL SCORE -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="SIGNAL SCORE" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_score_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold"
                        android:textColor="@color/text_primary" android:layout_marginTop="4dp" android:text="85 / 100" />
                    <ProgressBar android:id="@+id/progress_score" android:layout_width="match_parent"
                        android:layout_height="10dp" style="?android:attr/progressBarStyleHorizontal"
                        android:layout_marginTop="6dp" android:max="100" android:progress="85"
                        android:progressBackgroundTint="@color/divider" />
                    <TextView android:id="@+id/tv_streak" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="13sp"
                        android:layout_marginTop="10dp" android:text="↑ 3 consecutive up days" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- RSI -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="RSI (14)" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_rsi_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"
                        android:layout_marginTop="6dp" android:text="62.3  (Buy Zone ✅)" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- MACD -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="MACD (12, 26, 9)" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_macd_signal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                        android:layout_marginTop="6dp" android:text="▲ Bullish Crossover ✅" />
                    <TextView android:id="@+id/tv_macd_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="12sp"
                        android:textColor="@color/text_secondary" android:layout_marginTop="4dp"
                        android:text="Line 0.0012  Signal 0.0008" />
                    <TextView android:id="@+id/tv_macd_hist" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="12sp"
                        android:layout_marginTop="2dp" android:text="Histogram: 0.0004" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- EMA Crossover -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="EMA CROSSOVER (9 / 21)" android:textSize="11sp"
                        android:textColor="@color/text_secondary" android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_ema_signal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                        android:layout_marginTop="6dp" android:text="EMA9 > EMA21 — Bullish ✅" />
                    <TextView android:id="@+id/tv_ema_values" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="12sp"
                        android:textColor="@color/text_secondary" android:layout_marginTop="4dp"
                        android:text="EMA9: $148.50  EMA21: $145.20" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Volume -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="VOLUME ANALYSIS" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_volume_signal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                        android:layout_marginTop="6dp" android:text="Volume Surge ✅" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="4dp">
                        <TextView android:id="@+id/tv_volume_value" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:textSize="12sp" android:textColor="@color/text_secondary" android:text="150M" />
                        <TextView android:id="@+id/tv_volume_ratio" android:layout_width="0dp"
                            android:layout_height="wrap_content" android:layout_weight="1"
                            android:gravity="end" android:textSize="12sp"
                            android:textColor="@color/accent_gold" android:text="×2.1 of avg" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Moving Averages -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="10dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="TREND (vs Moving Averages)" android:textSize="11sp"
                        android:textColor="@color/text_secondary" android:textStyle="bold" android:letterSpacing="0.1" />
                    <TextView android:id="@+id/tv_ma50_signal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:layout_marginTop="8dp" android:text="✅ Above MA50" />
                    <TextView android:id="@+id/tv_ma200_signal" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="14sp"
                        android:layout_marginTop="6dp" android:text="✅ Above MA200" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Market Data -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="16dp"
                app:cardCornerRadius="14dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/bg_card">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="MARKET DATA" android:textSize="11sp" android:textColor="@color/text_secondary"
                        android:textStyle="bold" android:letterSpacing="0.1" />
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginTop="8dp" android:layout_marginBottom="10dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Day Range" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tv_day_range" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="13sp" android:text="—" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Market Cap" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tv_market_cap" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="13sp" android:text="—" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="52-Week Range" android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tv_52w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="13sp" android:text="—" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

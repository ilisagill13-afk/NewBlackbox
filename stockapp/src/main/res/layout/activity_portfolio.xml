<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_surface">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_dark"
        android:elevation="4dp"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/accent_gold" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="14dp">

            <!-- Summary Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp" app:cardElevation="4dp"
                app:cardBackgroundColor="@color/bg_dark">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="PORTFOLIO VALUE" android:textSize="11sp"
                        android:textColor="@color/text_secondary" android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView android:id="@+id/tv_total_value" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textSize="38sp"
                        android:textStyle="bold" android:textColor="@color/white"
                        android:layout_marginTop="4dp" android:text="$0.00" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="6dp">
                        <TextView android:id="@+id/tv_total_pl" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="18sp"
                            android:textStyle="bold" android:text="+$0.00" />
                        <TextView android:id="@+id/tv_total_pl_pct" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="18sp"
                            android:textStyle="bold" android:layout_marginStart="8dp" android:text="0.00%" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/divider" android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Invested" android:textSize="11sp"
                                android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_total_invested" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="16sp"
                                android:textStyle="bold" android:textColor="@color/white" android:text="$0.00" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:gravity="end">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Cash Available" android:textSize="11sp"
                                android:textColor="@color/text_secondary" />
                            <TextView android:id="@+id/tv_cash" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:textSize="16sp"
                                android:textStyle="bold" android:textColor="@color/accent_gold" android:text="$0.00" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginTop="12dp">
                        <Button android:id="@+id/btn_deposit"
                            android:layout_width="0dp" android:layout_height="48dp"
                            android:layout_weight="1" android:layout_marginEnd="6dp"
                            android:text="💰 Add Funds" android:textSize="14sp" android:textStyle="bold"
                            android:backgroundTint="@color/gain_green" android:textColor="@color/white" />
                        <Button android:id="@+id/btn_risk_settings"
                            android:layout_width="0dp" android:layout_height="48dp"
                            android:layout_weight="1" android:layout_marginStart="6dp"
                            android:text="🛡 Risk Settings" android:textSize="14sp" android:textStyle="bold"
                            android:backgroundTint="#1E3A5F" android:textColor="@color/white" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- At-Risk Alert -->
            <TextView android:id="@+id/tv_at_risk"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="12dp" android:layout_marginBottom="10dp"
                android:textSize="13sp" android:textStyle="bold"
                android:background="#1A2A00" android:visibility="gone"
                android:text="⚠ Positions at risk" />

            <!-- Positions -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MY POSITIONS" android:textSize="11sp"
                android:textColor="@color/text_secondary" android:textStyle="bold"
                android:letterSpacing="0.1" android:layout_marginBottom="8dp" />

            <TextView android:id="@+id/tv_empty_portfolio" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="No positions yet.\nDeposit funds and buy stocks from the main screen."
                android:textSize="14sp" android:textColor="@color/text_secondary"
                android:gravity="center" android:padding="32dp" android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_positions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
